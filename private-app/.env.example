NODE_ENV=production
APP_ORIGIN=https://YOUR-PRIVATE-APP-HOST.example
DATABASE_URL=postgresql://fortor_runtime:SET_IN_SECRET_MANAGER@DATABASE_HOST:5432/postgres?sslmode=verify-full
BETTER_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES_IN_SECRET_MANAGER
OWNER_GOOGLE_EMAIL=APPROVED_OWNER_GOOGLE_EMAIL
GOOGLE_CLIENT_ID=SET_IN_SECRET_MANAGER
GOOGLE_CLIENT_SECRET=SET_IN_SECRET_MANAGER
